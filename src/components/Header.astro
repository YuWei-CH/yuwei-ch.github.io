---
import { localeEntries, defaultLocale } from "../config";
import type { SiteConfig } from "../config";

const getNavigation = (config: SiteConfig) => {
  const { nav } = config.ui;
  return {
    primary: [
      ...(config.news.length ? [{ href: "/#news", label: nav.news }] : []),
      { href: "/#about", label: nav.about },
      ...(config.experience.length ? [{ href: "/#experience", label: nav.experience }] : []),
      ...(config.projects.length ? [{ href: "/#projects", label: nav.projects }] : []),
      ...(config.research.length ? [{ href: "/#research", label: nav.research }] : []),
      ...(config.education.length ? [{ href: "/#education", label: nav.education }] : []),
    ],
    more: [
      ...(config.memberships.length ? [{ href: "/involvement", label: nav.involvement }] : []),
      ...(config.hobbies.length ? [{ href: "/hobbies", label: nav.hobbies }] : []),
    ],
  };
};
---

<header id="header" class="fixed top-0 left-0 right-0 z-50 hidden xl:block transition-all duration-300">
  <nav class="max-w-7xl mx-auto px-8 py-4">
    {localeEntries.map(([lang, siteConfig]) => {
      const navigation = getNavigation(siteConfig);
      return (
        <ul class={`lang-block lang-${lang} flex items-center gap-8 justify-center`}>
          {navigation.primary.map((item) => (
            <li>
              <a href={item.href} class="text-gray-700 hover:text-black transition-colors font-medium">
                {item.label}
              </a>
            </li>
          ))}
          {navigation.more.length > 0 && (
            <li class="relative group">
              <button type="button" class="flex items-center gap-1 text-gray-700 hover:text-black transition-colors font-medium focus:outline-none">
                {siteConfig.ui.nav.more}
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="absolute left-1/2 -translate-x-1/2 mt-3 hidden group-hover:block group-focus-within:block bg-white border border-gray-200 rounded-lg shadow-lg min-w-[180px] py-2 z-50">
                {navigation.more.map((item) => (
                  <a href={item.href} class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">
                    {item.label}
                  </a>
                ))}
              </div>
            </li>
          )}
        </ul>
      );
    })}
  </nav>
</header>

<div class="fixed top-0 left-0 right-0 z-50 border-b border-gray-200 bg-white/90 backdrop-blur xl:hidden">
  {localeEntries.map(([lang, siteConfig]) => {
    const navigation = getNavigation(siteConfig);
    return (
      <div class={`lang-block lang-${lang}`} data-mobile-nav>
        <div class="flex items-center justify-between gap-3 px-4 py-3">
          <a href="/#hero" class="min-w-0 truncate text-sm font-semibold tracking-tight text-gray-900">
            {siteConfig.name}
          </a>
          <div class="flex items-center gap-2">
            <button class="mobile-language-toggle" type="button" data-lang-toggle data-active={defaultLocale} aria-label="Toggle language">
              <span class="mobile-language-option">EN</span>
              <span class="mobile-language-option">中文</span>
              <span class="mobile-language-knob"></span>
            </button>
            <button type="button" class="mobile-menu-button" data-mobile-menu-toggle data-open-label={siteConfig.ui.nav.openMenu} data-close-label={siteConfig.ui.nav.closeMenu} aria-expanded="false" aria-label={siteConfig.ui.nav.openMenu}>
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7h16M4 12h16M4 17h16" />
              </svg>
            </button>
          </div>
        </div>
        <div class="hidden border-t border-gray-200 bg-white" data-mobile-menu>
          <nav class="px-4 py-3">
            <ul class="space-y-1">
              {[...navigation.primary, ...navigation.more].map((item) => (
                <li>
                  <a href={item.href} class="mobile-menu-link" data-mobile-menu-link>{item.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      </div>
    );
  })}
</div>

<script>
  const syncHeaderBackground = () => {
    const header = document.getElementById("header");
    if (!header) return;

    if (window.scrollY > 100) {
      header.classList.add("bg-white/80", "backdrop-blur-sm");
    } else {
      header.classList.remove("bg-white/80", "backdrop-blur-sm");
    }
  };

  const closeAllMobileMenus = () => {
    document.querySelectorAll("[data-mobile-nav]").forEach((nav) => {
      const button = nav.querySelector("[data-mobile-menu-toggle]");
      const menu = nav.querySelector("[data-mobile-menu]");
      if (!(button instanceof HTMLButtonElement) || !(menu instanceof HTMLElement)) return;

      button.setAttribute("aria-expanded", "false");
      button.setAttribute("aria-label", button.dataset.openLabel || "Open menu");
      menu.classList.add("hidden");
    });
  };

  const initMobileMenus = () => {
    document.querySelectorAll("[data-mobile-nav]").forEach((nav) => {
      const button = nav.querySelector("[data-mobile-menu-toggle]");
      const menu = nav.querySelector("[data-mobile-menu]");
      if (!(button instanceof HTMLButtonElement) || !(menu instanceof HTMLElement)) return;

      const setOpen = (open: boolean) => {
        button.setAttribute("aria-expanded", String(open));
        button.setAttribute(
          "aria-label",
          open ? button.dataset.closeLabel || "Close menu" : button.dataset.openLabel || "Open menu"
        );
        menu.classList.toggle("hidden", !open);
      };

      setOpen(false);

      button.addEventListener("click", () => {
        setOpen(button.getAttribute("aria-expanded") !== "true");
      });

      nav.querySelectorAll("[data-mobile-menu-link]").forEach((link) => {
        link.addEventListener("click", () => {
          setOpen(false);
        });
      });
    });
  };

  syncHeaderBackground();
  initMobileMenus();
  window.addEventListener("scroll", syncHeaderBackground);
  window.addEventListener("hashchange", closeAllMobileMenus);
  window.addEventListener("resize", () => {
    if (window.innerWidth >= 1280) closeAllMobileMenus();
  });
</script>

<style>
  html {
    scroll-behavior: smooth;
  }

  .mobile-menu-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid #e5e7eb;
    border-radius: 9999px;
    color: #111827;
    background: #ffffff;
    transition: border-color 150ms ease, background-color 150ms ease;
  }

  .mobile-menu-button:hover {
    border-color: #d1d5db;
    background: #f9fafb;
  }

  .mobile-menu-link {
    display: block;
    padding: 0.75rem 0.25rem;
    color: #374151;
    font-weight: 500;
    border-bottom: 1px solid #f3f4f6;
  }

  .mobile-menu-link:hover {
    color: #111827;
  }

  .mobile-language-toggle {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.75rem;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 9999px;
    font-weight: 600;
    color: #111827;
    overflow: hidden;
  }

  .mobile-language-option {
    position: relative;
    z-index: 2;
    font-size: 0.75rem;
    transition: color 200ms ease;
  }

  .mobile-language-knob {
    position: absolute;
    inset: 4px;
    width: calc(50% - 6px);
    background: #111827;
    border-radius: 9999px;
    z-index: 1;
    transition: transform 200ms ease;
  }

  [data-active="zh"] .mobile-language-knob {
    transform: translateX(100%);
  }

  [data-active="en"] .mobile-language-option:first-of-type,
  [data-active="zh"] .mobile-language-option:nth-of-type(2) {
    color: #ffffff;
  }
</style>
