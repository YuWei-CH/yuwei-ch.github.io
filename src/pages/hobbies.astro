---
import { localeEntries, pageMeta } from "../config";
import { plainText, poemExcerpt, poemLines, poemNumber, poems } from "../config/poems";
import BaseLayout from "../layouts/BaseLayout.astro";

const meta = pageMeta((config) => ({
  title: `${config.name} - ${config.ui.hobbies.title}`,
  description: config.ui.hobbies.pageIntro,
}));
const accentColor = localeEntries[0][1].accentColor;
const favorite = poems.find((poem) => poem.favorite);
const poemHref = (slug: string) => `/hobbies/poetry/${slug}/`;
---

<BaseLayout meta={meta}>
  <main class="pt-16">
    <section class="p-8 sm:p-12 md:p-16 lg:p-24">
      {localeEntries.map(([lang, siteConfig]) => (
        <div class={`lang-block lang-${lang} max-w-4xl mx-auto space-y-6`}>
          <p class="text-sm font-semibold uppercase tracking-wide text-gray-500">
            {siteConfig.ui.common.moreAbout}
          </p>
          <h1 class="text-4xl sm:text-5xl font-bold text-gray-900">
            {siteConfig.ui.hobbies.title}
          </h1>
          <p class="text-lg sm:text-xl text-gray-600 leading-relaxed">
            {siteConfig.ui.hobbies.pageIntro}
          </p>
        </div>
      ))}
    </section>

    {localeEntries.map(([lang, siteConfig]) => {
      if (!siteConfig.hobbies || siteConfig.hobbies.length === 0) return;
      return (
        <section class={`lang-block lang-${lang} pb-12 sm:pb-16 md:pb-20 lg:pb-24 px-8 sm:px-12 md:px-16 lg:px-24`}>
          <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
            {siteConfig.hobbies.map((hobby, index) => (
              <div class="bg-white rounded-xl border border-gray-200 p-5 sm:p-6 shadow-sm hover:shadow-md transition-shadow duration-200">
                <div class="flex items-center justify-between mb-3">
                  <p class="text-sm font-mono" style={{ color: accentColor }}>
                    H0{index + 1}
                  </p>
                  <span class="inline-flex items-center px-3 py-1 text-xs font-semibold rounded-full bg-gray-100 text-gray-700">
                    {siteConfig.ui.hobbies.badge}
                  </span>
                </div>
                <h2 class="text-2xl font-semibold text-gray-900">{hobby.name}</h2>
                <p class="mt-3 text-sm sm:text-base text-gray-600 leading-relaxed">
                  {hobby.description}
                </p>
                {hobby.highlights && hobby.highlights.length > 0 && (
                  <ul class="mt-4 space-y-2">
                    {hobby.highlights.map((item) => (
                      <li class="flex items-start">
                        <span class="inline-block w-1.5 h-1.5 rounded-full bg-gray-400 mt-2 mr-3 flex-shrink-0" />
                        <span class="text-sm sm:text-base text-gray-700">{item}</span>
                      </li>
                    ))}
                  </ul>
                )}
                {hobby.link && (
                  <a href={hobby.link.href} class="mt-5 inline-flex text-sm font-semibold hover:underline" style={{ color: accentColor }}>
                    {hobby.link.label}
                  </a>
                )}
              </div>
            ))}
          </div>
        </section>
      );
    })}

    {poems.length > 0 && (
      <section id="poetry" class="pb-16 sm:pb-20 md:pb-24 px-8 sm:px-12 md:px-16 lg:px-24">
        <div class="max-w-5xl mx-auto" style={`--accent: ${accentColor}`}>
          {localeEntries.map(([lang, siteConfig]) => (
            <div class={`lang-block lang-${lang} mb-10`}>
              <p class="text-sm font-mono" style={{ color: accentColor }}>{siteConfig.ui.poetry.meta}</p>
              <h2 class="mt-2 text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900">{siteConfig.ui.poetry.title}</h2>
              <div class="w-[75px] h-[5px] mt-3 rounded-full" style={`background-color: ${accentColor}`} />
              <p class="mt-6 max-w-3xl text-base sm:text-lg text-gray-600 leading-relaxed">{siteConfig.ui.poetry.intro}</p>
            </div>
          ))}

          {favorite && (
            <a
              href={poemHref(favorite.slug)}
              class="group mb-10 block rounded-2xl border border-orange-100 bg-gradient-to-br from-orange-50 via-white to-white p-6 sm:p-10 shadow-sm transition-shadow duration-200 hover:shadow-md md:grid md:grid-cols-5 md:gap-10"
            >
              <div class="flex flex-col md:col-span-2">
                <span class="inline-flex w-fit items-center gap-1 rounded-full bg-orange-100 px-3 py-1 text-xs font-semibold text-orange-700">
                  ★
                  {localeEntries.map(([lang, siteConfig]) => (
                    <span class={`lang-block lang-${lang}`}>{siteConfig.ui.poetry.favorite}</span>
                  ))}
                </span>
                <p class="mt-5 text-sm font-mono" style={{ color: accentColor }}>No. {poemNumber(favorite)}</p>
                <h3 class="mt-1 text-3xl sm:text-4xl font-bold text-gray-900">{favorite.title}</h3>
                <span class="mt-6 md:mt-auto text-sm font-semibold group-hover:underline" style={{ color: accentColor }}>
                  {localeEntries.map(([lang, siteConfig]) => (
                    <span class={`lang-block lang-${lang}`}>{siteConfig.ui.poetry.read}</span>
                  ))}
                </span>
              </div>
              <blockquote class="mt-6 md:mt-0 md:col-span-3 border-l-4 pl-6 italic leading-loose text-gray-700" style={`border-color: ${accentColor}`}>
                {poemLines(favorite).slice(0, 7).map((line) => (
                  <span class="block">{plainText(line)}</span>
                ))}
                <span class="block text-gray-400">…</span>
              </blockquote>
            </a>
          )}

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
            {poems.map((poem) => (
              <a
                href={poemHref(poem.slug)}
                class="group flex flex-col rounded-xl border border-gray-200 bg-white p-5 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-md hover:border-[var(--accent)]"
              >
                <div class="flex items-center justify-between text-xs font-mono">
                  <span style={{ color: accentColor }}>No. {poemNumber(poem)}</span>
                  {poem.favorite && <span class="text-orange-500" aria-hidden="true">★</span>}
                </div>
                <h3 class="mt-3 text-lg font-semibold leading-snug text-gray-900">{poem.title}</h3>
                <p class="mt-2 line-clamp-2 text-sm italic leading-relaxed text-gray-500">{poemExcerpt(poem)}</p>
                <span class="mt-auto pt-4 text-sm font-medium text-gray-400 transition-colors group-hover:text-[var(--accent)]">
                  {localeEntries.map(([lang, siteConfig]) => (
                    <span class={`lang-block lang-${lang}`}>{siteConfig.ui.poetry.read}</span>
                  ))}
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>
</BaseLayout>
